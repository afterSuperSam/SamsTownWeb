# Browser-safe Supabase project values.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_API_URL=http://127.0.0.1:8787
# VITE_API_TIMEOUT_MS=15000
# VITE_IMAGE_UPLOAD_TIMEOUT_MS=120000

# Server-only values. Never expose these with a VITE_ prefix.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_REQUEST_TIMEOUT_MS=15000
# SITE_IMAGE_WEBP_QUALITY=90
# SITE_IMAGE_CACHE_SECONDS=31536000
# SITE_HERO_CACHE_MS=30000
API_HOST=127.0.0.1
API_PORT=8787
API_TRUST_PROXY=loopback
WEB_ORIGIN=http://127.0.0.1:5173
STORAGE_CLEANUP_INTERVAL_MS=300000
STORAGE_CLEANUP_MAX_ATTEMPTS=8
STORAGE_CLEANUP_BATCH_SIZE=50
STORAGE_CLEANUP_RETRY_BASE_MS=30000
STORAGE_CLEANUP_RETRY_MAX_MS=3600000
ACCOUNT_CLEANUP_INTERVAL_MS=300000

# 事务告知复用博客公开 JSON 接口，无需 RSS 解析器或浏览器跨域配置。
# BLOG_API_URL=https://blog.moesam.com/api/public/site-card.json
# BLOG_CACHE_MS=300000
# BLOG_REQUEST_TIMEOUT_MS=5000

ANALYTICS_IP_PEPPER=generate-an-independent-random-32-plus-character-secret

# Optional standalone encrypted backup tool; not used by the API process.
# BACKUP_DIRECTORY=D:\SamsTownBackups
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
# PG_PSQL_PATH=C:\Program Files\PostgreSQL\17\bin\psql.exe
# BACKUP_VERIFY_DATABASE_URL=postgresql://verify:SECRET@127.0.0.1:5433/isolated_verify?sslmode=disable
# BACKUP_ENCRYPTION_KEY=generate-an-independent-64-hex-character-secret
# BACKUP_BUCKETS=site-images,town-maps
# BACKUP_SUPABASE_CLI_PATH=C:\Tools\supabase.exe
# BACKUP_COMMAND_TIMEOUT_MS=1800000

# Optional maintenance tools; all destructive operations require a maintenance window.
# RETIRE_STORAGE_PAGE_SIZE=500
# RETIRE_STORAGE_BATCH_SIZE=100
# RETIRE_STORAGE_TIMEOUT_MS=30000
# DATA_RESET_BATCH_SIZE=100
# DATA_RESET_PAGE_SIZE=500
# DATA_RESET_REQUEST_TIMEOUT_MS=30000
# DATA_RESET_MAINTENANCE_WINDOW=confirmed
