{
  "name": "yingwu-town-web",
  "version": "2.2.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors cyan,magenta \"pnpm dev:web\" \"pnpm api:dev\"",
    "dev:web": "vite --configLoader runner --force",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -b",
    "api:dev": "tsx watch --env-file=.env server/index.ts",
    "api:build": "node -e \"require('node:fs').rmSync('dist-server',{recursive:true,force:true})\" && tsc -p server/tsconfig.json",
    "api:start": "node --env-file=.env dist-server/index.js",
    "check": "pnpm typecheck && pnpm api:build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "release:check": "pnpm check && pnpm lint && pnpm test && pnpm build && pnpm audit --prod && pnpm test:e2e"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@supabase/supabase-js": "2.57.4",
    "fastify": "5.12.6",
    "lucide-react": "0.468.0",
    "motion": "^12.42.2",
    "openseadragon": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "24.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.0.3",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.9.0"
}
